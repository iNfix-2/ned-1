# Nethawk Solutions: Apache config for the cPanel host (copied into dist/ by Vite)

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (behind Cloudflare the origin sees X-Forwarded-Proto)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www -> bare domain
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# The app routes with #/ hashes; any unknown path falls back to the app, which shows its 404 page
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HTML: always revalidate so visitors get new releases immediately
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Vite's fingerprinted bundles (name-HASH.js/css/woff2) never change: cache for a year
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Photos, video and documents keep their names when replaced: cache for a week
  <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico|mp4|webm|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddType image/webp .webp
</IfModule>
